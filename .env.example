# Clé API Anthropic (obligatoire) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modèles utilisés (optionnel, valeurs par défaut ci-dessous)
ANTHROPIC_MODEL_RECO=claude-opus-4-8
ANTHROPIC_MODEL_AUDIT=claude-sonnet-5
ANTHROPIC_MODEL_COMPETITORS=claude-opus-4-8

# Clé API Google PageSpeed Insights (optionnelle — l'audit de la landing
# page fonctionne sans clé mais avec un quota très limité)
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
