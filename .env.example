# Ces variables sont FACULTATIVES : l'outil te permet de saisir ta clé API
# OpenRouter (et optionnellement PageSpeed) directement dans la page
# "Réglages" de l'appli, stockée dans ton navigateur. Ce fichier ne sert
# que si tu préfères configurer les clés côté serveur/hébergeur à la place.

# Clé API OpenRouter — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Modèles utilisés (optionnel, valeurs par défaut ci-dessous — identifiants OpenRouter)
OPENROUTER_MODEL_RECO=anthropic/claude-opus-4.6
OPENROUTER_MODEL_AUDIT=anthropic/claude-sonnet-4.6
OPENROUTER_MODEL_COMPETITORS=anthropic/claude-opus-4.6

# Clé API Google PageSpeed Insights (optionnelle — l'audit de la landing
# page fonctionne sans clé mais avec un quota très limité)
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
